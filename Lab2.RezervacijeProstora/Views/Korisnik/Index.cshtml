@model List<Lab2.RezervacijeProstora.Models.Korisnik>

@{
    ViewData["Title"] = "Korisnici";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Korisnici</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Korisnici</h1>
        <p>Popis korisnika koji rezerviraju prostore za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Novi korisnik</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Ime, korisničko ime, email ili telefon";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_KorisnikCards" model="Model" />
    </div>
</section>
