@model List<Korisnik>

<div class="cards-grid">
    @foreach (var korisnik in Model)
    {
        <article class="custom-card">
            <h3>@korisnik.ImePrezime</h3>
            <p>@korisnik.KorisnickoIme</p>

            <div class="card-meta">
                <span>@korisnik.TipKorisnika</span>
                <span>@korisnik.Rezervacije.Count rezervacija</span>
            </div>

            <a asp-controller="Korisnik" asp-action="Details" asp-route-id="@korisnik.Id" class="details-link">Detalji korisnika</a>
            <a asp-action="Edit" asp-route-id="@korisnik.Id" class="details-link">Uredi</a>
            <a asp-action="Delete" asp-route-id="@korisnik.Id" class="details-link">Obriši</a>
        </article>
    }
</div>
