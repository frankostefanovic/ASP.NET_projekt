@model List<Lab2.RezervacijeProstora.Models.Placanje>

@{
    ViewData["Title"] = "Plaćanja";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Plaćanja</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Plaćanja</h1>
        <p>Popis svih izvršenih i neizvršenih plaćanja.</p>
        <a asp-action="Create" class="btn btn-primary">Novo plaćanje</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Transakcija, način plaćanja, korisnik ili prostor";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_PlacanjeCards" model="Model" />
    </div>
</section>
