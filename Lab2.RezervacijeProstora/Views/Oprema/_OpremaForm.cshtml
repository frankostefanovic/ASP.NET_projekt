@model Oprema

<div class="col-md-6">
    <label asp-for="Naziv" class="form-label"></label>
    <input asp-for="Naziv" class="form-control" />
    <span asp-validation-for="Naziv" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="Proizvodac" class="form-label"></label>
    <input asp-for="Proizvodac" class="form-control" />
    <span asp-validation-for="Proizvodac" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="Vrijednost" class="form-label"></label>
    <input asp-for="Vrijednost" class="form-control" type="number" step="0.01" />
    <span asp-validation-for="Vrijednost" class="text-danger"></span>
</div>
<div class="col-md-6 d-flex align-items-end">
    <div class="form-check">
        <input asp-for="Ispravna" class="form-check-input" />
        <label asp-for="Ispravna" class="form-check-label"></label>
    </div>
</div>
<div class="col-12">
    <button type="submit" class="btn btn-primary">Spremi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
</div>
