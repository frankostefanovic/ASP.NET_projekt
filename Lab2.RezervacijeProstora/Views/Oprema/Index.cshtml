@model List<Lab2.RezervacijeProstora.Models.Oprema>

@{
    ViewData["Title"] = "Oprema";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Oprema</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Oprema</h1>
        <p>Popis opreme dostupne u prostorima za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Nova oprema</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Naziv ili proizvođač";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_OpremaCards" model="Model" />
    </div>
</section>
