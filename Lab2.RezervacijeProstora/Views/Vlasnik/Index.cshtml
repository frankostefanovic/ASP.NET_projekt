@model List<Lab2.RezervacijeProstora.Models.Vlasnik>

@{
    ViewData["Title"] = "Vlasnici";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Vlasnici</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Vlasnici</h1>
        <p>Popis vlasnika prostora za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Novi vlasnik</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Ime, email, telefon ili OIB";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_VlasnikCards" model="Model" />
    </div>
</section>
