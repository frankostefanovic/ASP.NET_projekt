@{
    var placeholder = ViewData["SearchPlaceholder"] as string ?? "Pretraži...";
}

<form class="ajax-search" data-ajax-search data-search-url="@Url.Action("Search")" data-results-target="#ajax-results">
    <label class="form-label" for="ajax-search-input">Pretraga</label>
    <div class="ajax-search-row">
        <input id="ajax-search-input" name="q" class="form-control" type="search" placeholder="@placeholder" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Pretraži</button>
    </div>
    <p class="ajax-search-status" data-ajax-search-status></p>
</form>
