@model List<Lab2.RezervacijeProstora.Models.Recenzija>

@{
    ViewData["Title"] = "Recenzije";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Recenzije</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Recenzije</h1>
        <p>Mišljenja korisnika o prostorima za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Nova recenzija</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Korisnik, prostor ili komentar";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_RecenzijaCards" model="Model" />
    </div>
</section>
