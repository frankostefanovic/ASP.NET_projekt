@model Recenzija

<div class="col-md-6">
    @{
        ViewData["AutocompleteField"] = nameof(Model.KorisnikId);
        ViewData["AutocompleteLabel"] = "Korisnik";
        ViewData["AutocompleteUrl"] = Url.Action("Autocomplete", "Korisnik");
        ViewData["AutocompleteValue"] = Model.KorisnikId;
        ViewData["AutocompleteText"] = ViewBag.KorisnikLabel;
    }
    <partial name="_AutocompleteInput" />
</div>
<div class="col-md-6">
    @{
        ViewData["AutocompleteField"] = nameof(Model.ProstorId);
        ViewData["AutocompleteLabel"] = "Prostor";
        ViewData["AutocompleteUrl"] = Url.Action("Autocomplete", "ProstorZaProbu");
        ViewData["AutocompleteValue"] = Model.ProstorId;
        ViewData["AutocompleteText"] = ViewBag.ProstorLabel;
    }
    <partial name="_AutocompleteInput" />
</div>
<div class="col-md-6">
    <label asp-for="Ocjena" class="form-label"></label>
    <input asp-for="Ocjena" class="form-control" type="number" min="1" max="5" />
    <span asp-validation-for="Ocjena" class="text-danger"></span>
</div>
<div class="col-md-6">
    @{
        ViewData["DatePickerField"] = nameof(Model.DatumRecenzije);
        ViewData["DatePickerLabel"] = "Datum recenzije";
        ViewData["DatePickerValue"] = Model.DatumRecenzije;
    }
    <partial name="_DatePicker" />
</div>
<div class="col-12">
    <label asp-for="Komentar" class="form-label"></label>
    <textarea asp-for="Komentar" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Komentar" class="text-danger"></span>
</div>
<div class="col-12">
    <button type="submit" class="btn btn-primary">Spremi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
</div>
