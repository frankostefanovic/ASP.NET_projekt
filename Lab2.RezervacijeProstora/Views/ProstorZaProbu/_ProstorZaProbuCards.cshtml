@model List<ProstorZaProbu>

<div class="cards-grid">
    @foreach (var prostor in Model)
    {
        <article class="custom-card">
            <h3>@prostor.Naziv</h3>
            <p>@prostor.Lokacija.Grad, @prostor.Lokacija.Adresa</p>

            <div class="card-meta">
                <span>@prostor.KapacitetOsoba osoba</span>
                <span>@prostor.CijenaPoSatu € / h</span>
            </div>

            <div class="tag-row">
                @if (prostor.ImaParking)
                {
                    <span class="tag">Parking</span>
                }
                @if (prostor.ImaKlimu)
                {
                    <span class="tag">Klima</span>
                }
                @if (prostor.Aktivan)
                {
                    <span class="tag">Aktivan</span>
                }
                else
                {
                    <span class="tag muted">Neaktivan</span>
                }
            </div>

            <a asp-controller="ProstorZaProbu" asp-action="Details" asp-route-id="@prostor.Id" class="details-link">Pogledaj detalje</a>
            <a asp-action="Edit" asp-route-id="@prostor.Id" class="details-link">Uredi</a>
            <a asp-action="Delete" asp-route-id="@prostor.Id" class="details-link">Obriši</a>
        </article>
    }
</div>
