@model List<Lab2.RezervacijeProstora.Models.ProstorZaProbu>

@{
    ViewData["Title"] = "Prostori za probu";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Prostori za probu</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Prostori za probu</h1>
        <p>Odaberi prostor i pogledaj detalje o cijeni, opremi, lokaciji i rezervacijama.</p>
        <a asp-action="Create" class="btn btn-primary">Novi prostor</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Naziv, grad, adresa ili vlasnik";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_ProstorZaProbuCards" model="Model" />
    </div>
</section>
