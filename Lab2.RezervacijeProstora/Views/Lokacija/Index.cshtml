@model List<Lab2.RezervacijeProstora.Models.Lokacija>

@{
    ViewData["Title"] = "Lokacije";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Lokacije</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Lokacije</h1>
        <p>Popis lokacija na kojima se nalaze prostori za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Nova lokacija</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Grad, adresa, poštanski broj ili država";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_LokacijaCards" model="Model" />
    </div>
</section>
