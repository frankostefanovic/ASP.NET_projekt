@model List<Lab2.RezervacijeProstora.Models.Rezervacija>

@{
    ViewData["Title"] = "Rezervacije";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a>
    <span>/</span>
    <span>Rezervacije</span>
</nav>

<section class="section-block">
    <div class="section-heading">
        <p class="eyebrow">Pregled</p>
        <h1>Rezervacije</h1>
        <p>Popis svih rezervacija prostora za probe.</p>
        <a asp-action="Create" class="btn btn-primary">Nova rezervacija</a>
    </div>

    @{
        ViewData["SearchPlaceholder"] = "Korisnik, prostor, grad, status ili napomena";
    }
    <partial name="_AjaxSearch" />

    <div id="ajax-results">
        <partial name="_RezervacijaCards" model="Model" />
    </div>
</section>
