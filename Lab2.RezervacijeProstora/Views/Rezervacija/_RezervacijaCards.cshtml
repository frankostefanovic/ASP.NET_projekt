@model List<Rezervacija>

<div class="cards-grid">
    @foreach (var rezervacija in Model)
    {
        <article class="custom-card">
            <h3>@rezervacija.Prostor.Naziv</h3>
            <p>@rezervacija.Korisnik.ImePrezime</p>

            <div class="card-meta">
                <span>@rezervacija.Status</span>
                <span>@rezervacija.DatumVrijemeOd.ToString("dd.MM.yyyy. HH:mm")</span>
            </div>

            <div class="tag-row">
                <span class="tag">@rezervacija.BrojSudionika sudionika</span>
                <span class="tag">@rezervacija.UkupnaCijena() €</span>
            </div>

            <a asp-controller="Rezervacija" asp-action="Details" asp-route-id="@rezervacija.Id" class="details-link">Detalji rezervacije</a>
            <a asp-action="Edit" asp-route-id="@rezervacija.Id" class="details-link">Uredi</a>
            <a asp-action="Delete" asp-route-id="@rezervacija.Id" class="details-link">Obriši</a>
        </article>
    }
</div>
