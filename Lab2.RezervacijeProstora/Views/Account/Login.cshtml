@model Lab2.RezervacijeProstora.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Prijava";
}

<section class="page-hero">
    <div>
        <p class="eyebrow">Korisnicki racun</p>
        <h1>Prijava</h1>
    </div>
</section>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="entity-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Prijavi se</button>
        <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Registracija</a>
    </div>
</form>

@if (ViewBag.ExternalLogins != null)
{
    foreach (var provider in ViewBag.ExternalLogins)
    {
        <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mt-3">
            <button type="submit" name="provider" value="@provider.Name" class="btn btn-outline-primary">
                Prijava preko @provider.DisplayName
            </button>
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
